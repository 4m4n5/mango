# Copy to ~/.config/mango/voice.env on the Pi (not in git).
export MANGO_VOICE=1
export MANGO_TTS_DISABLED=1
export MANGO_SKIP_OVERLAY=1

# Native N0 fallback tiles are intentionally off by default.
export MANGO_FALLBACK_STREMIO=0
export MANGO_LEGACY_YOUTUBE=0

# N1+: catalog-service (stremio-core bridge + mpv play) on loopback :3020
export MANGO_CATALOG=1

# Recommendation rollout — conservative first-deploy posture. These flags do
# not delete preserved ratings/profiles/generations. Promote only through the
# exact-SHA gates in docs/FIRE_WATER_RATINGS.md and docs/YOUTUBE.md.
export MANGO_VOD_RECS_V2=off
export MANGO_VOD_BROWSE_V3=off
export MANGO_YOUTUBE_RECS_V2=off
# Removed keys: MANGO_VOD_CONTENT_PROFILE and
# MANGO_STORY_DNA_AUTONOMOUS_BACKFILL. Do not re-add them; old rows stay intact.
export MANGO_STORY_DNA=0
export MANGO_STORY_DNA_WORKER_MODE=off
export MANGO_TMDB_METADATA=off

# Opt-in progressive frontier defaults (titles, not provider requests). Keep
# worker mode off until migration/budget/failure and Pi shadow proof passes.
export MANGO_STORY_DNA_FRONTIER_NIGHTLY_PER_TYPE=12
export MANGO_STORY_DNA_FRONTIER_ROLLING_30D=96
export MANGO_STORY_DNA_FRONTIER_BATCH=4
export MANGO_STORY_DNA_FRONTIER_RUN_MS=900000
export MANGO_STORY_DNA_FRONTIER_COALESCE_MS=900000

# Optional exact-ID TMDB enrichment is credential-gated. Leave secrets in
# device-owned files, never in this repository example.
export MANGO_TMDB_API_KEY_FILE=/etc/mango/tmdb.key
export MANGO_TMDB_REQUESTS_PER_SECOND=5

# Persona tone/policy from repo (orchestrator prefers this over /etc when set)
export MANGO_COMPANION_DIR="$HOME/mango/config/companion.example"
