{
  "_profile": "m6.5-tv-mpv-4k-sdr-hifi",
  "_notes": [
    "High-fidelity couch profile for the tuned mpv engine (set-playback-engine.sh mpv-hifi).",
    "4K hi-fi: tries cached HEVC 4K REMUX (HDR/DV first when that is the highest-quality release, then SDR).",
    "exclude_hdr on the SDR-only 4K steps drops HDR so SDR encodes/remuxes can win when both exist.",
    "HDR 4K uses tuned mpv tone-mapping (clip + audio sync + GPU-from-spawn) — stream quality is not reduced.",
    "require_hevc locks every >1080p step to HEVC — the only codec the Pi 5 decodes in hardware — so a 4K H.264/AV1/VP9 release never auto-plays and stutters; such titles fall through to a 1080p (any-codec) step instead.",
    "REMUX is confined to the 4K steps; 1080p stays on efficient encodes to avoid high-bitrate AVC software-decode load.",
    "Cached-only (include_uncached=false) so debrid serves the high bitrate fast enough to avoid rebuffering."
  ],
  "exclude_uncached_debrid": true,
  "strict_unknown_cache": true,
  "max_quality": "4k",
  "preferred_quality": "4k",
  "preferred_hdr_tags": ["DV", "HDR10", "HDR"],
  "preferred_video_codecs": ["hevc", "x265", "h265"],
  "exclude_remux": false,
  "include_uncached": false,
  "exclude_error_streams": true,
  "uncached_torbox_fallback": false,
  "rd_safe_unknown_fallback": false,
  "stream_display_limit": 10,
  "auto_play_max_attempts": 8,
  "auto_play_wall_ms": 90000,
  "auto_play_probe_ms": 10000,
  "auto_play_uncached_probe_ms": 25000,
  "play_ladder": [
    {
      "step": "4k_hdr_remux_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": false,
      "require_hevc": true,
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "4k_sdr_remux_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": false,
      "require_hevc": true,
      "exclude_hdr": true,
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "4k_sdr_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": true,
      "require_hevc": true,
      "exclude_hdr": true,
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_hevc_cached",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_cached_fallback",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_uncached_fallback",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached_or_uncached",
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    }
  ],
  "auto_play_tiers": [
    {
      "addons": ["AIOStreams"],
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"]
    }
  ]
}
