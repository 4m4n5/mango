{
  "_profile": "m6.5-tv-mpv-4k-sdr-hifi",
  "_notes": [
    "High-fidelity couch profile for the tuned mpv engine (set-playback-engine.sh mpv-hifi).",
    "Smoothness-first: prefer HW-smooth streams over marginal soft-decode 4K. 4K HEVC (Pi 5 HW) ranks above 1080p; soft 4K AV1/H.264 ranks below 1080p as a play fallback.",
    "exclude_hdr on the 4K steps drops HDR above 1080p: X11 cannot output HDR, so a 4K HDR frame would be GPU tone-mapped to SDR every frame and the Pi 5 cannot sustain that at 4K (heavy stutter). HDR titles fall through to 1080p or last_resort at play time.",
    "Display (GET /stream) expands verified steps only: 4k_sdr_remux_cached, 4k_sdr_cached, 1080p_hevc_cached, 1080p_cached_fallback. Soft 4K, uncached, and last_resort are play-only (never shown as verified).",
    "Play order: 4K HEVC → 1080p smooth → soft 4K → 1080p uncached → last_resort → Phase B obligation floor. Thin titles whose only release is soft 4K still auto-play.",
    "REMUX is confined to the 4K steps; 1080p stays on efficient encodes to avoid high-bitrate AVC software-decode load.",
    "Cached-only (include_uncached=false) so debrid serves the high bitrate fast enough to avoid rebuffering."
  ],
  "exclude_uncached_debrid": true,
  "strict_unknown_cache": true,
  "max_quality": "4k",
  "preferred_quality": "4k",
  "preferred_hdr_tags": [],
  "preferred_video_codecs": ["hevc", "x265", "h265"],
  "exclude_remux": false,
  "include_uncached": false,
  "exclude_error_streams": true,
  "uncached_torbox_fallback": false,
  "rd_safe_unknown_fallback": false,
  "stream_display_limit": 10,
  "auto_play_max_attempts": 8,
  "auto_play_wall_ms": 90000,
  "auto_play_probe_ms": 10000,
  "auto_play_uncached_probe_ms": 25000,
  "play_ladder": [
    {
      "step": "4k_sdr_remux_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": false,
      "require_hevc": true,
      "exclude_hdr": true,
      "require_cache": "cached",
      "verified": true,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "4k_sdr_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": true,
      "require_hevc": true,
      "exclude_hdr": true,
      "require_cache": "cached",
      "verified": true,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_hevc_cached",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached",
      "verified": true,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_cached_fallback",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached",
      "verified": true,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "4k_sdr_soft_cached",
      "max_quality": "2160p",
      "min_quality": "2160p",
      "exclude_remux": true,
      "require_hevc": false,
      "exclude_hdr": true,
      "require_cache": "cached",
      "verified": false,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "1080p_uncached_fallback",
      "max_quality": "1080p",
      "exclude_remux": true,
      "require_cache": "cached_or_uncached",
      "verified": false,
      "debrid_services": ["torbox", "realdebrid"],
      "addons": ["AIOStreams"]
    },
    {
      "step": "last_resort",
      "max_quality": "2160p",
      "exclude_remux": false,
      "require_hevc": false,
      "require_cache": "any",
      "verified": false,
      "debrid_services": ["torbox", "realdebrid"],
      "rd_safe_unknown": true,
      "addons": ["AIOStreams"]
    }
  ],
  "auto_play_tiers": [
    {
      "addons": ["AIOStreams"],
      "require_cache": "cached",
      "debrid_services": ["torbox", "realdebrid"]
    }
  ]
}
