[Unit]
Description=mango catalog-service
After=network-online.target mango-aiometadata.service
Wants=network-online.target mango-aiometadata.service

[Service]
Type=simple
WorkingDirectory=%h/mango
Environment=HOME=%h
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=MANGO_CATALOG=1
ExecStartPre=/bin/mkdir -p %h/.cache/mango
ExecStart=%h/mango/scripts/m2-catalog/service/run-catalog-service.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
# Resource guards. Memory enforces once the cgroup memory controller is enabled at
# boot (cgroup_enable=memory in cmdline.txt); CPUWeight/TasksMax enforce already.
# CPUWeight<100 lets the foreground launcher/pad win CPU under contention.
MemoryAccounting=yes
MemoryHigh=1280M
MemoryMax=1536M
TasksMax=512
CPUWeight=60

[Install]
WantedBy=default.target
