[Unit]
Description=mango loopback YouTube PO-token provider
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/mango/scripts/m6-ship/youtube-pot-server.sh

[Service]
Type=simple
WorkingDirectory=%h/mango
Environment=HOME=%h
ExecStart=/usr/bin/bash %h/mango/scripts/m6-ship/youtube-pot-server.sh run
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
MemoryAccounting=yes
MemoryHigh=320M
MemoryMax=384M
TasksMax=64
CPUWeight=15
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
