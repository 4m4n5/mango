[Unit]
Description=mango TV pad router (8BitDo Micro)
After=bluetooth.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=HOME=%h
Environment=USER=%u
Environment=MANGO_TV_USER=%u
Environment=MANGO_PAD_NAV_API=1
ExecStartPre=-/bin/rm -f %h/.cache/mango/mango-tv-pad.pid %h/.cache/mango/mango-tv-pad-status.json
ExecStartPre=-/usr/bin/sudo -n /usr/bin/systemctl stop input-remapper
ExecStartPre=-/usr/bin/sudo -n /usr/bin/pkill -f input-remapper-reader-service
ExecStart=/usr/bin/sudo -n %h/mango/scripts/m1-foundation/pad/run-mango-tv-pad.sh
KillMode=control-group
TimeoutStopSec=5
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
